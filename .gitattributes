# Normalize line endings in the repository; check out with the platform default.
* text=auto

# CRLF everywhere, whatever core.autocrlf says: source bytes feed the PDB checksums, so a fixed
# line ending keeps builds of the same commit comparable.
*.cs      text eol=crlf diff=csharp
*.md      text diff=markdown
*.csproj  text eol=crlf
*.props   text eol=crlf
*.sln     text eol=crlf
*.ps1     text eol=crlf

*.dll     binary
*.exe     binary
*.zip     binary
